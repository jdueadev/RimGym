<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net480</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <!-- Mod Info -->
        <RootNamespace>RimworldMLBridge</RootNamespace>
        <AssemblyName>RimworldMLBridge</AssemblyName>
        <VersionPrefix>1.0.0.0</VersionPrefix>
        <!-- Output directly to 1.6/Assemblies folder -->
        <OutputPath>..\1.6\Assemblies</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <!-- Do not generate pdb file -->
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <!-- Disable auto-generated assembly info to avoid duplicates with Properties\AssemblyInfo.cs -->
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <!-- RimWorld paths - update these to match your installation -->
        <RimWorldPath Condition="'$(RimWorldPath)' == ''">C:\gaming\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldPath>
        <WorkshopPath Condition="'$(WorkshopPath)' == ''">C:\gaming\steamapps\workshop\content\294100</WorkshopPath>
        <HarmonyPath Condition="'$(HarmonyPath)' == ''">C:\gaming\steamapps\workshop\content\294100\2009463077\Current\Assemblies</HarmonyPath>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Google.Protobuf"
                          Version="3.33.2" />
        <PackageReference Include="Grpc.Core"
                          Version="2.46.6"
                          ExcludeAssets="native" />
        <PackageReference Include="Grpc.Tools"
                          Version="2.76.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Krafs.Rimworld.Ref"
                          Version="1.6.4633" />
    </ItemGroup>
    <ItemGroup>
        <Protobuf Include="..\Protos\mlbridge.proto"
                  GrpcServices="Server" />
    </ItemGroup>
    <ItemGroup Condition="Exists('$(RimWorldPath)\Assembly-CSharp.dll')">
        <!-- RimWorld Assemblies - Use local installation when available -->
        <Reference Include="Assembly-CSharp">
            <HintPath>$(RimWorldPath)\Assembly-CSharp.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(RimWorldPath)\UnityEngine.CoreModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <!-- Harmony -->
        <Reference Include="0Harmony">
            <HintPath>$(HarmonyPath)\0Harmony.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>
    <ItemGroup Condition="!Exists('$(RimWorldPath)\Assembly-CSharp.dll')">
        <!-- Use Krafs.Rimworld.Ref NuGet package when local DLLs not available (Docker/CI) -->
        <PackageReference Include="Lib.Harmony"
                          Version="2.3.3" />
    </ItemGroup>
    <!-- Remove native DLLs that RimWorld's mod loader can't handle -->
    <Target Name="RemoveNativeDlls"
            AfterTargets="AfterBuild">
        <ItemGroup>
            <NativeDllsToRemove Include="$(OutputPath)grpc_csharp_ext*.*" />
            <NativeDllsToRemove Include="$(OutputPath)libgrpc_csharp_ext*.*" />
            <NativeDllsToRemove Include="$(OutputPath)*.so" />
            <NativeDllsToRemove Include="$(OutputPath)*.dylib" />
        </ItemGroup>
        <Delete Files="@(NativeDllsToRemove)"
                ContinueOnError="true" />
        <RemoveDir Directories="$(OutputPath)runtimes"
                   Condition="Exists('$(OutputPath)runtimes')"
                   ContinueOnError="true" />
        <Message Text="Cleaned up native libraries: @(NativeDllsToRemove->Count()) files removed"
                 Importance="high" />
    </Target>
</Project>