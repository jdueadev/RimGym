# .editorconfig
# https://editorconfig.org

# Top-most EditorConfig file
root = true

# =============================================================================
# Universal Settings - Apply to ALL files
# =============================================================================
[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# =============================================================================
# C# Files - RimWorld Mod (RimTCP)
# =============================================================================
[*.cs]
indent_size = 4
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# C# code style - namespace declarations
csharp_style_namespace_declarations = file_scoped:suggestion

# C# code style - expression-bodied members
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

# C# code style - pattern matching
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion

# C# code style - null checking
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion

# C# code style - var preferences
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# C# formatting - new lines
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# C# formatting - indentation
csharp_indent_case_contents = true
csharp_indent_switch_labels = true

# C# formatting - spacing
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false

# =============================================================================
# .NET Project Files
# =============================================================================
[*.csproj]
indent_size = 2

[*.props]
indent_size = 2

[*.targets]
indent_size = 2

[*.sln]
indent_style = tab

# =============================================================================
# Python Files - RimGym ML Client
# =============================================================================
[*.py]
indent_size = 4
max_line_length = 88

# =============================================================================
# Protocol Buffers - Shared Schema
# =============================================================================
[*.proto]
indent_size = 2

# =============================================================================
# TypeScript/JavaScript - RimStats Dashboard
# =============================================================================
[*.{ts,tsx}]
indent_size = 2
quote_type = single

[*.{js,jsx}]
indent_size = 2
quote_type = single

[*.json]
indent_size = 2

# =============================================================================
# Web Assets
# =============================================================================
[*.{css,scss,less}]
indent_size = 2

[*.html]
indent_size = 2

# =============================================================================
# Configuration Files - YAML
# =============================================================================
[*.{yml,yaml}]
indent_size = 2

# =============================================================================
# Shell Scripts
# =============================================================================
[*.sh]
indent_size = 2
end_of_line = lf

[*.ps1]
indent_size = 4
end_of_line = crlf

[*.{cmd,bat}]
indent_size = 4
end_of_line = crlf

# =============================================================================
# Docker
# =============================================================================
[Dockerfile]
indent_size = 2

[docker-compose*.{yml,yaml}]
indent_size = 2

# =============================================================================
# Documentation - Markdown
# =============================================================================
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# =============================================================================
# XML Files
# =============================================================================
[*.xml]
indent_size = 2

# =============================================================================
# Generated/Build Output - Do not modify
# =============================================================================
[**/obj/**]
generated_code = true

[**/bin/**]
generated_code = true

[**/__pycache__/**]
generated_code = true

[*.min.js]
insert_final_newline = false

[*.min.css]
insert_final_newline = false
